# Ponte em Cena — Instagram builder env (LOCAL runs only).
# Copy to `.env` and fill. NEVER commit `.env` (it is gitignored).
# In CI these live as GitHub repository Secrets, not in a file.

# Long-lived Instagram access token (Business/Creator account). Required for LIVE mode.
IG_TOKEN=

# Instagram user id. Optional — defaults to /me/media when the token is user-scoped.
IG_USER_ID=

# Graph API base. Default (Instagram-Login flow, no Facebook Page needed):
#   https://graph.instagram.com
# For the Facebook-Login Graph API (needs a linked FB Page) use e.g.:
#   https://graph.facebook.com/v21.0
GRAPH_BASE=https://graph.instagram.com
